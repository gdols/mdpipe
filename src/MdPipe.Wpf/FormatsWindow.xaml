<Window x:Class="MdPipe.Wpf.FormatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What MdPipe can convert"
        SizeToContent="Height" Width="520" MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Background}"
        Icon="/Assets/icon.png"
        FontFamily="Segoe UI">

    <Border Margin="26" Background="{StaticResource Surface}" CornerRadius="14"
            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="28">
        <StackPanel>
            <TextBlock Text="What MdPipe can convert" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" />
            <TextBlock x:Name="SourceLine" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />

            <Border Height="1" Background="{StaticResource Border}" Margin="0,18,0,16" />

            <ItemsControl x:Name="Extensions">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#EFF6FF" CornerRadius="6" Padding="9,4" Margin="0,0,7,7">
                            <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="CountLine" FontSize="12.5" Margin="0,8,0,0"
                       Foreground="{StaticResource TextMuted}" />

            <Border Height="1" Background="{StaticResource Border}" Margin="0,18,0,16" />

            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       Text="Dragging a file in converts it whatever its extension, so this list only limits what gets picked up when you drop a whole folder. Tick 'Try every file' to attempt those too and let the engine decide by what's inside them." />

            <Button Content="Close" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Margin="0,18,0,0"
                    IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Border>
</Window>
